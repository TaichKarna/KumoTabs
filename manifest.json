{
  "manifest_version": 3,
  "name": "KumoTabs",
  "version": "1.0",
  "description": "Organize your tabs into projects",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon162.png",
      "48": "icons/icon482.png",
      "128": "icons/icon1282.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon162.png",
    "48": "icons/icon482.png",
    "128": "icons/icon1282.png"
  }
}
